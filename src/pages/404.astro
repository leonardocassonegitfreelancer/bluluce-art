---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 – Page Not Found | BLULUCE ART"
  description="The page you are looking for does not exist."
  canonical="/404"
  lang="es"
>
  <div style="display:flex;min-height:100vh;align-items:center;justify-content:center;background:#f5f0e8;font-family:'Lora',serif;">
    <div style="text-align:center;">
      <h1 style="font-size:4rem;font-weight:700;margin-bottom:1rem;font-family:'Playfair Display',serif;">404</h1>
      <p style="font-size:1.25rem;margin-bottom:1.5rem;color:#666;">Oops! Page not found</p>
      <a href="/" style="color:#8b4513;text-decoration:underline;">Return to Home</a>
    </div>
  </div>
</Layout>


---
import Layout from "../../layouts/Layout.astro";
import IndexPageWrapper from "../../page-components/IndexPageWrapper";
import { th } from "../../i18n/homeTranslations";
import type { Lang } from "../../i18n/homeTranslations";

export function getStaticPaths() {
  return [
    { params: { lang: "lt" } },
    { params: { lang: "en" } },
    { params: { lang: "it" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

const titles: Record<Lang, string> = {
  lt: "LALIMENTARI | Italų restoranas Vilniuje – Autentiška itališka virtuvė",
  en: "LALIMENTARI | Italian Restaurant in Vilnius – Authentic Italian Cuisine",
  it: "LALIMENTARI | Ristorante Italiano a Vilnius – Cucina Italiana Autentica",
};

const restaurantJsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "@id": "https://lalimentari.lt",
  name: "LALIMENTARI",
  description: "Ristorante italiano a Vilnius con pasta fresca fatta a mano, focacce, antipasti e vini italiani. Cucina autentica italiana nel cuore di Vilnius.",
  image: "https://lalimentari.lt/og-image.webp",
  url: "https://lalimentari.lt",
  telephone: "+37066408338",
  email: "info@lalimentari.lt",
  servesCuisine: ["Italian"],
  hasMenu: "https://lalimentari.lt/lt/menu",
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Gedimino pr. 37",
    addressLocality: "Vilnius",
    postalCode: "01103",
    addressCountry: "LT",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 54.6872,
    longitude: 25.2797,
  },
  sameAs: [
    "https://maps.app.goo.gl/e6wLibn3uXbb4WG37",
    "https://www.facebook.com/LalimentariVilnius/",
    "https://www.instagram.com/lalimentari.vilnius/",
  ],
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"], opens: "10:00", closes: "21:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Friday", opens: "10:00", closes: "22:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "10:00", closes: "22:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Sunday", opens: "11:00", closes: "21:00" },
  ],
};
---

<Layout
  title={titles[lang]}
  description={th("heroDescDesktop", lang)}
  canonical={`/${lang}`}
  lang={lang}
  jsonLd={restaurantJsonLd}
>
  <IndexPageWrapper lang={lang} client:only="react" />
</Layout>

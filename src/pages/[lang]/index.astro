---
import Layout from "../../layouts/Layout.astro";
import IndexPageWrapper from "../../page-components/IndexPageWrapper";
import { th } from "../../i18n/homeTranslations";
import type { Lang } from "../../i18n/homeTranslations";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
    { params: { lang: "it" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

const titles: Record<Lang, string> = {
  es: "Vittoria De Raimondi – BLULUCE ART | Pinturas Originales del Mediterráneo",
  en: "Vittoria De Raimondi – BLULUCE ART | Original Mediterranean Paintings",
  it: "Vittoria De Raimondi – BLULUCE ART | Dipinti Originali del Mediterraneo",
};

const artGalleryJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://bluluceart.com/#vittoria",
      name: "Vittoria De Raimondi",
      jobTitle: lang === "it" ? "Pittrice" : lang === "es" ? "Pintora" : "Painter",
      description: lang === "it"
        ? "Pittrice italiana a Málaga, ispirata dall'Impressionismo e dai colori del Mediterraneo."
        : lang === "es"
          ? "Pintora italiana afincada en Málaga, inspirada por el Impresionismo y los colores del Mediterráneo."
          : "Italian painter based in Málaga, inspired by Impressionism and the colours of the Mediterranean.",
      url: "https://bluluceart.com",
      sameAs: ["https://www.instagram.com/bluluce.art/"],
      image: "https://bluluceart.com/og-image.webp",
      nationality: "Italian",
      knowsAbout: ["Acrylic painting", "Mediterranean art", "Impressionism"],
    },
    {
      "@type": "ArtGallery",
      "@id": "https://bluluceart.com",
      name: "BLULUCE ART",
      description: "Original paintings and artworks inspired by the light, the sea, and the colors of the Mediterranean.",
      image: "https://bluluceart.com/og-image.webp",
      url: "https://bluluceart.com",
      email: "info@bluluceart.com",
      founder: { "@id": "https://bluluceart.com/#vittoria" },
      artist: { "@id": "https://bluluceart.com/#vittoria" },
      sameAs: ["https://www.instagram.com/bluluce.art/"],
    },
  ],
};
---

<Layout
  title={titles[lang]}
  description={th("heroDescDesktop", lang)}
  canonical={`/${lang}`}
  lang={lang}
  jsonLd={artGalleryJsonLd}
>
  <IndexPageWrapper lang={lang} client:load />
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import IndexPageWrapper from "../../page-components/IndexPageWrapper";
import IntroLoader from "../../components/IntroLoader.astro";
import { th } from "../../i18n/homeTranslations";
import type { Lang } from "../../i18n/homeTranslations";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
    { params: { lang: "it" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

const titles: Record<Lang, string> = {
  es: "BLULUCE ART | Pinturas originales y arte del Mediterráneo",
  en: "BLULUCE ART | Original Paintings & Mediterranean Art",
  it: "BLULUCE ART | Dipinti Originali & Arte Mediterranea",
};

const artGalleryJsonLd = {
  "@context": "https://schema.org",
  "@type": "ArtGallery",
  "@id": "https://bluluceart.com",
  name: "BLULUCE ART",
  description: "Original paintings and artworks inspired by the light, the sea, and the colors of the Mediterranean.",
  image: "https://bluluceart.com/og-image.webp",
  url: "https://bluluceart.com",
  email: "info@bluluceart.com",
  sameAs: [
    "https://www.instagram.com/bluluce.art/",
  ],
};
---

<Layout
  title={titles[lang]}
  description={th("heroDescDesktop", lang)}
  canonical={`/${lang}`}
  lang={lang}
  jsonLd={artGalleryJsonLd}
>
  <IntroLoader lang={lang} />
  <IndexPageWrapper lang={lang} client:load />
</Layout>

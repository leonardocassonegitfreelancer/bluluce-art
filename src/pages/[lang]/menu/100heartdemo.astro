---
import Layout from "../../../layouts/Layout.astro";
import MenuDemoPageWrapper from "../../../page-components/MenuDemoPageWrapper";

export function getStaticPaths() {
  return [
    { params: { lang: "lt" } },
    { params: { lang: "en" } },
    { params: { lang: "it" } },
  ];
}

const { lang } = Astro.params;
---

<Layout
  title="Menu Demo | LALIMENTARI"
  description="LALIMENTARI menu demo experience."
  canonical={`/${lang}/menu/100heartdemo`}
  lang={lang}
  robots="noindex, nofollow"
>
  <MenuDemoPageWrapper lang={lang} client:only="react" />
</Layout>

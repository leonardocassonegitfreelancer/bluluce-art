---
import Layout from "../../../layouts/Layout.astro";
import GalleryHall from "@/components/GalleryHall";
import type { Lang } from "../../../i18n/homeTranslations";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
    { params: { lang: "it" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

const titles: Record<Lang, string> = {
  es: "Galería | BLULUCE ART – Pinturas y arte del Mediterráneo",
  en: "Gallery | BLULUCE ART – Paintings & Mediterranean Art",
  it: "Galleria | BLULUCE ART – Dipinti e Arte del Mediterraneo",
};

const descriptions: Record<Lang, string> = {
  es: "Explora la galería digital de BLULUCE ART. Pinturas originales y obras de arte inspiradas en la luz, el mar y los colores del Mediterráneo.",
  en: "Explore the digital gallery of BLULUCE ART. Original paintings and artworks inspired by the light, the sea, and the colors of the Mediterranean.",
  it: "Esplora la galleria digitale di BLULUCE ART. Dipinti originali e opere d'arte ispirati alla luce, al mare e ai colori del Mediterraneo.",
};
---

<Layout
  title={titles[lang]}
  description={descriptions[lang]}
  canonical={`/${lang}/gallery`}
  lang={lang}
>
  <GalleryHall mode="full" lang={lang} homeHref={`/${lang}`} client:only="react" />
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import AboutPageWrapper from "../../page-components/AboutPageWrapper";
import type { Lang } from "../../i18n/homeTranslations";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
    { params: { lang: "it" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

const titles: Record<Lang, string> = {
  es: "Vittoria De Raymondi | Pintora Italiana en Málaga – BLULUCE ART",
  en: "Vittoria De Raymondi | Italian Painter in Málaga – BLULUCE ART",
  it: "Vittoria De Raymondi | Pittrice Italiana a Málaga – BLULUCE ART",
};

const descriptions: Record<Lang, string> = {
  es: "Vittoria De Raymondi, pintora italiana afincada en Málaga. Obras originales sobre lino y tela con pigmentos naturales y pan de oro, inspiradas en el Mediterráneo.",
  en: "Vittoria De Raymondi, Italian painter based in Málaga. Original works on linen and canvas with natural pigments and gold leaf, inspired by the Mediterranean.",
  it: "Vittoria De Raymondi, pittrice italiana a Málaga. Opere originali su lino e tela con pigmenti naturali e foglia d'oro, ispirate al Mediterraneo.",
};
---

<Layout
  title={titles[lang]}
  description={descriptions[lang]}
  canonical={`/${lang}/about`}
  lang={lang}
>
  <AboutPageWrapper lang={lang} client:only="react" />
</Layout>

---
import Layout from "../../../layouts/Layout.astro";
import CategoryPageWrapper from "../../../page-components/CategoryPageWrapper";
import { th } from "../../../i18n/homeTranslations";
import type { Lang, TranslationKey } from "../../../i18n/homeTranslations";
import type { CategorySlug } from "../../../i18n/slugs";

const productsSlug: Record<string, string> = {
  es: "tienda",
  en: "shop",
  it: "collezione",
};

type CategoryMeta = { nameKey: TranslationKey; descKey: TranslationKey; ogImage: string };

const categoryMeta: Record<CategorySlug, CategoryMeta> = {
  mare:  { nameKey: "collectionMareTitle",  descKey: "collectionMareDesc",  ogImage: "/og-mare.webp" },
  fuoco: { nameKey: "collectionFuocoTitle", descKey: "collectionFuocoDesc", ogImage: "/og-fuoco.webp" },
  terra: { nameKey: "collectionTerraTitle", descKey: "collectionTerraDesc", ogImage: "/og-terra.webp" },
};

export function getStaticPaths() {
  const langs = ["es", "en", "it"];
  const slugMap: Record<string, string> = { es: "tienda", en: "shop", it: "collezione" };
  const cats: CategorySlug[] = ["mare", "fuoco", "terra"];

  return langs.flatMap((lang) =>
    cats.map((category) => ({
      params: { lang, products: slugMap[lang], category },
    }))
  );
}

const { lang, category } = Astro.params as { lang: Lang; products: string; category: CategorySlug };
const meta = categoryMeta[category];
const title = meta
  ? `${th(meta.nameKey, lang)} | Vittoria De Raymondi – BLULUCE ART`
  : `${category} | BLULUCE ART`;
const description = meta ? th(meta.descKey, lang) : "";
const ogImage = meta?.ogImage;
---

<Layout
  title={title}
  description={description}
  canonical={`/${lang}/${productsSlug[lang]}/${category}`}
  lang={lang}
  image={ogImage}
>
  <CategoryPageWrapper lang={lang} category={category} client:only="react" />
</Layout>

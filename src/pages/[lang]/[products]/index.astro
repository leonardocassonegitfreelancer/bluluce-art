---
import Layout from "../../../layouts/Layout.astro";
import ProductsPageWrapper from "../../../page-components/ProductsPageWrapper";
import type { Lang } from "../../../i18n/homeTranslations";

const productsSlug: Record<string, string> = {
  es: "tienda",
  en: "shop",
  it: "collezione",
};

export function getStaticPaths() {
  return [
    { params: { lang: "es", products: "tienda" } },
    { params: { lang: "en", products: "shop" } },
    { params: { lang: "it", products: "collezione" } },
  ];
}

const { lang } = Astro.params as { lang: Lang; products: string };

const titles: Record<Lang, string> = {
  es: "Colecciones de Arte | BLULUCE ART – Pinturas inspiradas en el Mediterráneo",
  en: "Art Collections | BLULUCE ART – Mediterranean Fine Art Paintings",
  it: "Collezioni d'Arte | BLULUCE ART – Dipinti d'Arte Mediterranea",
};

const descriptions: Record<Lang, string> = {
  es: "Explora las colecciones exclusivas de BLULUCE ART. Pinturas originales de las colecciones Mar, Tierra y Olivo creadas con materiales naturales.",
  en: "Explore the exclusive art collections of BLULUCE ART. Original paintings from the Ocean, Clay, and Olive collections.",
  it: "Esplora le collezioni d'arte esclusive di BLULUCE ART. Dipinti originali delle collezioni Mare, Terra e Ulivo realizzati con pigmenti naturali.",
};
---

<Layout
  title={titles[lang]}
  description={descriptions[lang]}
  canonical={`/${lang}/${productsSlug[lang]}`}
  lang={lang}
>
  <ProductsPageWrapper lang={lang} client:only="react" />
</Layout>

---
import Layout from "../../../layouts/Layout.astro";
import ProductsPageWrapper from "../../../page-components/ProductsPageWrapper";
import type { Lang } from "../../../i18n/homeTranslations";

const productsSlug: Record<string, string> = {
  es: "tienda",
  en: "shop",
  it: "collezione",
};

export function getStaticPaths() {
  return [
    { params: { lang: "es", products: "tienda" } },
    { params: { lang: "en", products: "shop" } },
    { params: { lang: "it", products: "collezione" } },
  ];
}

const { lang } = Astro.params as { lang: Lang; products: string };

const titles: Record<Lang, string> = {
  es: "Vittoria De Raimondi | Colecciones de Arte – BLULUCE ART",
  en: "Vittoria De Raimondi | Art Collections – BLULUCE ART",
  it: "Vittoria De Raimondi | Collezioni d'Arte – BLULUCE ART",
};

const descriptions: Record<Lang, string> = {
  es: "Colecciones de pintura original de Vittoria De Raimondi — Mar, Fuego y Tierra. Acrílico sobre lienzo inspirado en la luz y los colores del Mediterráneo.",
  en: "Original painting collections by Vittoria De Raimondi — Ocean, Fire and Earth. Acrylic on canvas inspired by Mediterranean light and colours.",
  it: "Collezioni di dipinti originali di Vittoria De Raimondi — Mare, Fuoco e Terra. Acrilico su tela ispirato alla luce e ai colori del Mediterraneo.",
};
---

<Layout
  title={titles[lang]}
  description={descriptions[lang]}
  canonical={`/${lang}/${productsSlug[lang]}`}
  lang={lang}
>
  <ProductsPageWrapper lang={lang} client:only="react" />
</Layout>

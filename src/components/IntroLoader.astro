---
import silhouetteImg from "../assets/hero-silhouette.png";
import ninfeImg from "../assets/Ninfe picture for the home.webp";
import seaImg from "../assets/mediterranean_sea.webp";
import oliveImg from "../assets/olive_sun.webp";
import scorciImg from "../assets/scorci_mediterraneo.webp";
import clayImg from "../assets/terracotta_clay.webp";
import type { Lang } from "../i18n/homeTranslations";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;

const translations = {
  es: {
    navDipinti: "Dipinti,",
    navArte: "Arte,",
    navMed: "Mediterraneo"
  },
  en: {
    navDipinti: "Paintings,",
    navArte: "Art,",
    navMed: "Mediterranean"
  },
  it: {
    navDipinti: "Dipinti,",
    navArte: "Arte,",
    navMed: "Mediterraneo"
  }
};

const t = translations[lang] || translations.es;
---

<!-- Swiper CSS CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />

<section class="bluluce-header-desktop hidden md:block">
  <!-- Cutout silhouette foreground frame -->
  <img class="hero" src={silhouetteImg.src} alt="" fetchpriority="high" />

  <!-- Swiper Slider behind -->
  <div class="swiper">
    <div class="swiper-wrapper">
      <!-- Slide 1: Ninfe -->
      <div class="swiper-slide">
        <img class="slider-img" src={ninfeImg.src} loading="eager" alt="Ninfe" />
      </div>

      <!-- Slide 2: Mare -->
      <div class="swiper-slide">
        <img class="slider-img" src={seaImg.src} loading="lazy" alt="Mare" />
      </div>

      <!-- Slide 3: Ulivo -->
      <div class="swiper-slide">
        <img class="slider-img" src={oliveImg.src} loading="lazy" alt="Ulivo" />
      </div>

      <!-- Slide 4: Scorci -->
      <div class="swiper-slide">
        <img class="slider-img" src={scorciImg.src} loading="lazy" alt="Scorci" />
      </div>

      <!-- Slide 5: Terra -->
      <div class="swiper-slide">
        <img class="slider-img" src={clayImg.src} loading="lazy" alt="Terra" />
      </div>
    </div>
  </div>

  <!-- Header Overlay Content (Nav and White Letters) -->
  <div class="bluluce-header__content">
    <div class="bluluce-header__top">
      <nav class="bluluce-nav">
        <div class="bluluce-nav__start">
          <span class="bluluce-nav__link">BLULUCE ©</span>
        </div>
        <div class="bluluce-nav__end">
          <div class="bluluce-nav__links">
            <span class="bluluce-nav__link">{t.navDipinti}</span>
            <span class="bluluce-nav__link">{t.navArte}</span>
            <span class="bluluce-nav__link">{t.navMed}</span>
          </div>
        </div>
      </nav>
    </div>
    
    <div class="bluluce-header__bottom">
      <div class="bluluce__h1-white">
        <span class="bluluce__letter-white">B</span>
        <span class="bluluce__letter-white">l</span>
        <span class="bluluce__letter-white">u</span>
        <span class="bluluce__letter-white">l</span>
        <span class="bluluce__letter-white">u</span>
        <span class="bluluce__letter-white">c</span>
        <span class="bluluce__letter-white">e</span>
        <span class="bluluce__letter-white is--space">A</span>
        <span class="bluluce__letter-white">r</span>
        <span class="bluluce__letter-white">t</span>
        <span class="bluluce__letter-white is--space">©</span>
      </div>
    </div>
  </div>
</section>

<!-- Swiper JS CDN -->
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

<script>
  import { gsap } from "gsap";

  function initBluluceHero() {
    const container = document.querySelector(".bluluce-header-desktop");
    if (!container) return;

    // 1. Initialize Swiper from global Swiper constructor
    const SwiperConstructor = (window as any).Swiper;
    if (SwiperConstructor) {
      const swiper = new SwiperConstructor(".swiper", {
        grabCursor: true,
        speed: 600,
        effect: "slide",
        loop: true,
        mousewheel: false, // Disables mousewheel lock to allow natural page scrolling
        autoplay: {
          delay: 5000,
          disableOnInteraction: false,
        },
      });
      swiper.enable();
    }

    // 2. Run GSAP Animations for logo text and nav links
    const headerLetters = container.querySelectorAll(".bluluce__letter-white");
    const navLinks = container.querySelectorAll(".bluluce-nav span, .bluluce-nav__link");

    const tl = gsap.timeline({
      defaults: {
        ease: "expo.out",
        duration: 1.5,
      }
    });

    if (headerLetters.length) {
      tl.fromTo(headerLetters, {
        yPercent: 100,
      }, {
        yPercent: 0,
        stagger: 0.025,
      }, 0.2);
    }

    if (navLinks.length) {
      tl.fromTo(navLinks, {
        yPercent: 100,
      }, {
        yPercent: 0,
        stagger: 0.08,
      }, "<");
    }
  }

  // Hook into both standard load and Astro's transitions
  document.addEventListener("DOMContentLoaded", initBluluceHero);
  document.addEventListener("astro:page-load", initBluluceHero);
</script>

<style>
  @font-face {
    font-family: 'PP Neue Montreal';
    src: url('https://cdn.prod.website-files.com/6819ed8312518f61b84824df/6819ed8312518f61b84825ba_PPNeueMontreal-Medium.woff2') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  .bluluce-header-desktop {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background-color: #FAFAF8;
    overflow: hidden;
    color: #FAFAF8;
    font-family: 'PP Neue Montreal', Arial, sans-serif;
  }

  /* Scoped global styles for Swiper structure */
  .bluluce-header-desktop :global(.swiper) {
    width: 100%;
    height: 100%;
  }

  .bluluce-header-desktop :global(.swiper-slide) {
    position: relative;
    text-align: center;
    font-size: 18px;
    background: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bluluce-header-desktop :global(.swiper-slide .slider-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  /* Cutout silhoutte */
  .bluluce-header-desktop .hero {
    position: absolute;
    bottom: 0;
    z-index: 5;
    width: 100%;
    max-width: 550px;
    filter: contrast(90%);
    pointer-events: none;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Original Header Overlay Styles */
  .bluluce-header__content {
    display: flex;
    flex-flow: column;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 3rem;
    position: absolute;
    inset: 0;
    z-index: 6; /* Put in front of .hero cutout (z-index 5) */
    pointer-events: none;
  }

  /* Top Navigation */
  .bluluce-header__top {
    width: 100%;
    position: relative;
  }

  .bluluce-nav {
    display: flex;
    position: relative;
    overflow: hidden;
  }

  .bluluce-nav__start {
    justify-content: flex-start;
    align-items: flex-start;
    width: 50%;
    display: flex;
  }

  .bluluce-nav__end {
    justify-content: flex-end;
    align-items: flex-start;
    width: 50%;
    display: flex;
  }

  .bluluce-nav__links {
    display: flex;
    gap: 0.5rem;
  }

  .bluluce-nav__link {
    color: inherit;
    font-size: 1.25rem;
    line-height: 1.3;
    position: relative;
    display: inline-block;
    letter-spacing: -0.01em;
    font-weight: 500;
  }

  /* Bottom Header containing the final white logo */
  .bluluce-header__bottom {
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    display: flex;
    position: relative;
    overflow: hidden;
  }

  .bluluce__h1-white {
    white-space: nowrap;
    justify-content: center;
    font-size: clamp(3rem, 7vw, 7.5rem);
    font-weight: 500;
    line-height: .75;
    display: flex;
    position: relative;
    letter-spacing: -0.02em;
  }

  .bluluce__letter-white {
    display: block;
    position: relative;
  }

  .bluluce__letter-white.is--space {
    margin-left: 0.28em;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .bluluce-header__content {
      padding: 1.5rem;
    }
    .bluluce-nav__link {
      font-size: 0.95rem;
    }
  }
</style>

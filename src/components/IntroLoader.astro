---
import ninfeImg from "../assets/Ninfe picture for the home.webp";
---

<section class="bluluce-header-desktop hidden md:block">
  <!-- Background Image -->
  <div class="bluluce-header__bg">
    <img class="bluluce__cover-image" src={ninfeImg.src} loading="eager" alt="" />
  </div>

  <!-- Header Overlay Content (Nav and White Letters) -->
  <div class="bluluce-header__content">
    <div class="bluluce-header__top">
      <nav class="bluluce-nav">
        <div class="bluluce-nav__start">
          <span class="bluluce-nav__link">BLULUCE ©</span>
        </div>
        <div class="bluluce-nav__end">
          <div class="bluluce-nav__links">
            <span class="bluluce-nav__link">Dipinti,</span>
            <span class="bluluce-nav__link">Arte,</span>
            <span class="bluluce-nav__link">Mediterraneo</span>
          </div>
        </div>
      </nav>
    </div>
    
    <div class="bluluce-header__bottom">
      <div class="bluluce__h1-white">
        <span class="bluluce__letter-white">B</span>
        <span class="bluluce__letter-white">l</span>
        <span class="bluluce__letter-white">u</span>
        <span class="bluluce__letter-white">l</span>
        <span class="bluluce__letter-white">u</span>
        <span class="bluluce__letter-white">c</span>
        <span class="bluluce__letter-white">e</span>
        <span class="bluluce__letter-white is--space">A</span>
        <span class="bluluce__letter-white">r</span>
        <span class="bluluce__letter-white">t</span>
        <span class="bluluce__letter-white is--space">©</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  function initBluluceHero() {
    const container = document.querySelector(".bluluce-header-desktop");
    if (!container) return;

    const headerLetters = container.querySelectorAll(".bluluce__letter-white");
    const navLinks = container.querySelectorAll(".bluluce-nav span, .bluluce-nav__link");

    const tl = gsap.timeline({
      defaults: {
        ease: "expo.out",
        duration: 1.5,
      }
    });

    if (headerLetters.length) {
      tl.fromTo(headerLetters, {
        yPercent: 100,
      }, {
        yPercent: 0,
        stagger: 0.025,
      }, 0.2);
    }

    if (navLinks.length) {
      tl.fromTo(navLinks, {
        yPercent: 100,
      }, {
        yPercent: 0,
        stagger: 0.08,
      }, "<");
    }
  }

  // Run on page load
  document.addEventListener("DOMContentLoaded", initBluluceHero);
  document.addEventListener("astro:page-load", initBluluceHero);
</script>

<style>
  @font-face {
    font-family: 'PP Neue Montreal';
    src: url('https://cdn.prod.website-files.com/6819ed8312518f61b84824df/6819ed8312518f61b84825ba_PPNeueMontreal-Medium.woff2') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  .bluluce-header-desktop {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background-color: #FAFAF8;
    overflow: hidden;
    color: #FAFAF8;
    font-family: 'PP Neue Montreal', Arial, sans-serif;
  }

  .bluluce-header__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .bluluce__cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    pointer-events: none;
    user-select: none;
  }

  .bluluce-header__content {
    display: flex;
    flex-flow: column;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 3rem;
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  /* Top Navigation */
  .bluluce-header__top {
    width: 100%;
    position: relative;
  }

  .bluluce-nav {
    display: flex;
    position: relative;
    overflow: hidden;
  }

  .bluluce-nav__start {
    justify-content: flex-start;
    align-items: flex-start;
    width: 50%;
    display: flex;
  }

  .bluluce-nav__end {
    justify-content: flex-end;
    align-items: flex-start;
    width: 50%;
    display: flex;
  }

  .bluluce-nav__links {
    display: flex;
    gap: 0.5rem;
  }

  .bluluce-nav__link {
    color: inherit;
    font-size: 1.25rem;
    line-height: 1.3;
    position: relative;
    display: inline-block;
    letter-spacing: -0.01em;
    font-weight: 500;
  }

  /* Bottom Header containing the final white logo */
  .bluluce-header__bottom {
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    display: flex;
    position: relative;
    overflow: hidden;
  }

  .bluluce__h1-white {
    white-space: nowrap;
    justify-content: center;
    font-size: clamp(3rem, 7vw, 7.5rem);
    font-weight: 500;
    line-height: .75;
    display: flex;
    position: relative;
    letter-spacing: -0.02em;
  }

  .bluluce__letter-white {
    display: block;
    position: relative;
  }

  .bluluce__letter-white.is--space {
    margin-left: 0.28em;
  }
</style>

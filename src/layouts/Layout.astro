---
import "../index.css";
import CookieBanner from "../components/CookieBanner";

interface Props {
  title: string;
  description: string;
  canonical: string;
  lang: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  lang,
  image,
  jsonLd,
  robots = "index, follow",
} = Astro.props;

const BASE_URL = "https://bluluceart.com";
const DEFAULT_IMAGE = "https://bluluceart.com/og-image.webp";
const LANGS = ["es", "en", "it"] as const;
const subPath = canonical.replace(/^\/(es|en|it)/, "") || "";
const ogImage = image ? `${BASE_URL}${image}` : DEFAULT_IMAGE;
const canonicalUrl = `${BASE_URL}${canonical}`;

const localeMap: Record<string, string> = { it: "it_IT", es: "es_ES", en: "en_GB" };
const ogLocale = localeMap[lang] ?? "it_IT";
const altLocales = LANGS.filter((l) => l !== lang).map((l) => localeMap[l]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    {
      LANGS.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={`${BASE_URL}/${l}${subPath}`}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${BASE_URL}/es${subPath}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BLULUCE ART" />
    <meta property="og:locale" content={ogLocale} />
    {altLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} – Vittoria De Raymondi`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bluluceart" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${title} – Vittoria De Raymondi`} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <meta name="geo.region" content="ES-MA" />
    <meta name="geo.placename" content="Málaga" />
    <meta name="geo.position" content="36.7213;-4.4214" />
    <meta name="ICBM" content="36.7213, -4.4214" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;1,400;1,600&family=Crimson+Pro:wght@400;600&family=Jost:wght@300;400&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="grain-overlay" aria-hidden="true"></div>
    <slot />
    <CookieBanner lang={lang} client:load />
  </body>
</html>
